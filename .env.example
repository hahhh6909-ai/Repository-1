nano .env.example

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Sender ID / numbers registered with Twilio
TWILIO_SMS_FROM=+15005550006
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# E.164 numbers explicitly opted in by recipients
# Example: +6281234567890,+6289876543210
ALLOWED_TO=

# App safety limits
MAX_MESSAGES_PER_HOUR=3
MAX_CALLS_PER_HOUR=1
MAX_TOTAL_ACTIONS_PER_HOUR=10

# Fixed voice notification (plain text)
VOICE_MESSAGE=This is an authorized test notification.

# Local OTP lifetime in seconds
OTP_TTL_SECONDS=300