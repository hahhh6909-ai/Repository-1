import readline from "node:readline/promises";
import { stdin as input, stdout as output } from "node:process";

import { validateConfig } from "./lib/config.js";
import { sendSms, sendWhatsApp, makeCall } from "./lib/providers.js";
import { createOtp, verifyOtp } from "./lib/otp.js";
import { dispatchLink } from "./lib/dispatcher.js";

const rl = readline.createInterface({ input, output });

const cyan = "\x1b[36m";
const green = "\x1b[32m";
const reset = "\x1b[0m";

function banner() {
      console.clear();
        console.log(`${cyan}
         _   _ E O N G U A R D
         | \\ | |  SECURITY TOOLKIT
         |  \\| |  TERMUX / NODE.JS
         | |\\  |  AUTHORIZED OPERATIONS ONLY
         |_| \\_|${reset}`);
           console.log(`${green}====================================${reset}`);
}

async function ask(question) {
      return (await rl.question(`${cyan}${question}${reset}`)).trim();
}

async function runAction(label, action) {
      try {
            const result = await action();
                console.log(`${green}[OK] ${label}${reset}`);
                    if (result?.sid) console.log("Provider SID:", result.sid);
                        if (result?.status) console.log("Status:", result.status);
                            if (result?.reason) console.log(result.reason);
                                if (result?.valid !== undefined) {
                                          console.log("Valid:", result.valid);
                                }
      } catch (error) {
            console.log(`\x1b[31m[ERROR] ${error.message}${reset}`);
              }
              
                await ask("\nTekan Enter untuk melanjutkan...");
                }
                
                async function main() {
                      try {
                            validateConfig();
                              } catch (error) {
                                    console.log(`\x1b[31mKonfigurasi: ${error.message}${reset}`);
                                        console.log("Periksa file .env lalu jalankan ulang.");
                                            return;
                                              }
                                              
                                                while (true) {
                                                        banner();
                                                        
                                                            console.log(`
                                                              [1] OTP Security Tester (lokal)
                                                                [2] Kirim SMS
                                                                  [3] Kirim WhatsApp
                                                                    [4] Panggilan suara
                                                                      [5] Kirim tautan berizin
                                                                        [0] Keluar
                                                                        `);

                                                                            const choice = await ask("NeonGuard > ");

                                                                                if (choice === "0") break;

                                                                                    if (choice === "1") {
                                                                                              console.log("\n[1] Buat OTP  [2] Verifikasi OTP");
                                                                                                    const sub = await ask("Pilih > ");
                                                                                                          const id = await ask("ID sesi uji > ");

                                                                                                                if (sub === "1") {
                                                                                                                            await runAction("OTP dibuat (lokal)", async () => {
                                                                                                                                          const result = createOtp(id);
                                                                                                                                                    console.log("Kode uji lokal:", result.code);
                                                                                                                                                              console.log("Masa berlaku:", result.expiresInSeconds, "detik");
                                                                                                                                                                        return { reason: "Jangan gunakan kode uji untuk akun nyata." };
                                                                                                                            });
                                                                                                                } else if (sub === "2") {
                                                                                                                            const code = await ask("Masukkan kode uji > ");
                                                                                                                                    await runAction("Verifikasi selesai", async () =>
                                                                                                                                              verifyOtp(id, code)
                                                                                                                                    );
                                                                                                                }
                                                                                                                      continue;
                                                                                    }

                                                                                        if (choice === "2" || choice === "3") {
                                                                                                  const number = await ask("Nomor penerima berizin (+62...) > ");
                                                                                                        const message = await ask("Isi pesan > ");

                                                                                                              await runAction("Permintaan pesan", () =>
                                                                                                                      choice === "2"
                                                                                                                                ? sendSms(number, message)
                                                                                                                                          : sendWhatsApp(number, message)
                                                                                                              );
                                                                                                                    continue;
                                                                                        }

                                                                                            if (choice === "4") {
                                                                                                      const number = await ask("Nomor penerima berizin (+62...) > ");

                                                                                                            await runAction("Permintaan panggilan", () =>
                                                                                                                    makeCall(number)
                                                                                                            );
                                                                                                                  continue;
                                                                                            }

                                                                                                if (choice === "5") {
                                                                                                          const channel = await ask("Channel (sms/whatsapp) > ");
                                                                                                                const number = await ask("Nomor penerima berizin (+62...) > ");
                                                                                                                      const url = await ask("URL HTTPS > ");

                                                                                                                            await runAction("Permintaan pengiriman tautan", () =>
                                                                                                                                    dispatchLink(channel, number, url)
                                                                                                                            );
                                                                                                                                  continue;
                                                                                                }

                                                                                                    console.log("Pilihan tidak tersedia.");
                                                                                                        await ask("Tekan Enter untuk melanjutkan...");
                                                }
                }

                main()
                  .catch(error => console.error("Fatal:", error.message))
                    .finally(() => rl.close());
                                                                                                                            })
                                                                                                                }
                                }
      }
}]]]